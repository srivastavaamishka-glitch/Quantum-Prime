:root {
    --accent-teal: #2dd4bf;
    --accent-blue: #3b82f6;
    --accent-red: #ef4444;
    --accent-gold: #fbbf24;
    --bg-dark: #0a0c10;
}
body {
    font-family: 'Inter', sans-serif;
    background-color: var(--bg-dark);
    overflow-x: hidden;
    color: #e2e8f0;
}
/* --- SHARED STYLES --- */
#bg-canvas {
    position: fixed;
    top: 0; left: 0;
    z-index: -1;
}

.glass-panel {
    background: rgba(13, 17, 23, 0.7);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
}
/* --- LOGIN SPECIFIC STYLES --- */
.axis-line {
    position: fixed;
    left: 50%; top: 0;
    width: 1px; height: 100%;
    background: linear-gradient(to bottom, transparent, rgba(45, 212, 191, 0.1), transparent);
    z-index: 0;
    transition: opacity 0.5s;
}

.input-container {
    position: relative;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 12px;
    overflow: hidden;
}

.input-container::before {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 100%; height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent-teal));
    transition: 0.5s;
}

.input-container:focus-within::before { left: 100%; }

.logo-part { transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
.dna-helix { animation: pulse 3s infinite ease-in-out; }

@keyframes pulse {
    0%, 100% { filter: drop-shadow(0 0 2px var(--accent-teal)); opacity: 0.7; }
    50% { filter: drop-shadow(0 0 12px var(--accent-teal)); opacity: 1; }
}


