<body>
    <div class="main-container">
        <div class="brand-section">
            <div class="orbital-system">
                <div class="core-glow"></div>
                <div class="ring ring-1"></div>
                <div class="ring ring-2"></div>
                <div class="ring ring-3"></div>
                <div class="ring ring-4"></div>
            </div>
            <div class="logo-container">
                <i class="fa-solid fa-infinity logo-icon"></i>
                <h2>QUANTUM PRIME</h2>
            </div>
            <div class="hero-content">
                <div class="hero-text">
                    <h1>ARTHA TWIN</h1>
                    <p class="subtitle">Predictive Financial Life Simulator</p>
                    <div class="typing-container">
                        <span class="static-text">We help you </span>
                        <span id="typing-text"></span><span class="cursor">|</span>
                    </div>
                </div>
                <div class="feature-pills">
                    <div class="pill"><i class="fa-solid fa-chart-line"></i> 10-Year Projection</div>
                    <div class="pill"><i class="fa-solid fa-bolt"></i> Chaos Engine</div>
                    <div class="pill"><i class="fa-solid fa-robot"></i> AI Assistance</div>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="login-card">
                <h3>Welcome</h3>
                <p class="form-instruction">Access your digital financial twin.</p>
                <form id="loginForm">
                    <div class="input-group">
                        <label>User ID / Email</label>
                        <div class="input-wrapper">
                            <i class="fa-regular fa-user"></i>
                            <input type="email" placeholder="professional@example.com" required>
                        </div>
                    </div>
                    <div class="input-group">
                        <label>Security Key</label>
                        <div class="input-wrapper">
                            <i class="fa-solid fa-fingerprint"></i>
                            <input type="password" placeholder="••••••••" required>
                        </div>
                    </div>
                    <div class="actions">
                        <label class="checkbox-container">
                            <input type="checkbox" checked> <span class="checkmark"></span> Remember Data
                        </label>
                        <a href="#" class="forgot-pass">Reset Key?</a>
                    </div>
                    <button type="submit" class="btn-primary">INITIALIZE SIMULATION <i class="fa-solid fa-arrow-right-long"></i></button>
                    <div class="divider"><span>OR CONNECT VIA</span></div>
                    <div class="social-login">
                        <button type="button" class="btn-social google"><i class="fa-brands fa-google"></i></button>
                        <button type="button" class="btn-social linkedin"><i class="fa-brands fa-linkedin-in"></i></button>
                    </div>
                    <p class="signup-link">New? <a href="#">Create Logic Profile</a></p>
                </form>
            </div>
        </div>
    </div>
    <script src="login.js"></script>
</body>
