:root {
    --accent-teal: #2dd4bf;
    --accent-blue: #3b82f6;
    --accent-red: #ef4444;
    --accent-gold: #fbbf24;
    --bg-dark: #0a0c10;
}
body {
    font-family: 'Inter', sans-serif;
    background-color: var(--bg-dark);
    overflow-x: hidden;
    color: #e2e8f0;
}
/* --- SHARED STYLES --- */
#bg-canvas {
    position: fixed;
    top: 0; left: 0;
    z-index: -1;
}

.glass-panel {
    background: rgba(13, 17, 23, 0.7);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
}
/* --- LOGIN SPECIFIC STYLES --- */
.axis-line {
    position: fixed;
    left: 50%; top: 0;
    width: 1px; height: 100%;
    background: linear-gradient(to bottom, transparent, rgba(45, 212, 191, 0.1), transparent);
    z-index: 0;
    transition: opacity 0.5s;
}

.input-container {
    position: relative;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 12px;
    overflow: hidden;
}

.input-container::before {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 100%; height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent-teal));
    transition: 0.5s;
}

.input-container:focus-within::before { left: 100%; }

.logo-part { transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
.dna-helix { animation: pulse 3s infinite ease-in-out; }

@keyframes pulse {
    0%, 100% { filter: drop-shadow(0 0 2px var(--accent-teal)); opacity: 0.7; }
    50% { filter: drop-shadow(0 0 12px var(--accent-teal)); opacity: 1; }
}
.btn-scan { position: relative; overflow: hidden; }
.btn-scan::after {
    content: "";
    position: absolute;
    top: -50%; left: -50%;
    width: 200%; height: 200%;
    background: linear-gradient(0deg, transparent, rgba(45, 212, 191, 0.1), transparent);
    transform: rotate(45deg);
    transition: 0.5s;
    pointer-events: none;
}
.btn-scan:hover::after { left: 100%; top: 100%; }

.required-indicator { color: var(--accent-teal); margin-left: 4px; }

.custom-checkbox {
    appearance: none;
    width: 16px; height: 16px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px; background: rgba(255, 255, 255, 0.05);
    cursor: pointer;
    position: relative; transition: all 0.3s;
}
.custom-checkbox:checked { background: var(--accent-teal); border-color: var(--accent-teal); }
.custom-checkbox:checked::after {
    content: '✓';
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%); color: black; font-size: 10px; font-weight: bold;
}

/* --- SETUP/CALIBRATION SPECIFIC STYLES --- */
.holo-input {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
}
.holo-input:focus {
    background: rgba(45, 212, 191, 0.05);
    border-color: var(--accent-teal);
    box-shadow: 0 0 15px rgba(45, 212, 191, 0.1);
    outline: none;
}
.step-line {
    position: absolute;
    top: 50%; left: 0;
    width: 100%; height: 2px;
    background: rgba(255, 255, 255, 0.1); z-index: 0;
}
.step-active-line {
    position: absolute;
    top: 50%; left: 0; height: 2px;
    background: var(--accent-teal); z-index: 0; transition: width 0.5s ease;
}
.step-dot {
    width: 12px;
    height: 12px; background: var(--bg-dark);
    border: 2px solid rgba(255, 255, 255, 0.3); border-radius: 50%;
    position: relative; z-index: 10;
    transition: all 0.3s ease;
}
.step-dot.active { background: var(--accent-teal); border-color: var(--accent-teal); box-shadow: 0 0 10px var(--accent-teal); }
.step-dot.completed { background: var(--accent-teal); border-color: var(--accent-teal); }
input[type=range] { -webkit-appearance: none; width: 100%; background: transparent; }
input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none;
    height: 20px; width: 20px;
    border-radius: 50%; background: var(--accent-teal); cursor: pointer;
    margin-top: -8px; box-shadow: 0 0 10px rgba(45, 212, 191, 0.5);
}
input[type=range]::-webkit-slider-runnable-track {
    width: 100%;
    height: 4px; cursor: pointer;
    background: rgba(255, 255, 255, 0.1); border-radius: 2px;
}

.view-section { transition: opacity 0.5s ease; }
.hidden-view { display: none; opacity: 0; }

/* --- DASHBOARD STYLES --- */
.stat-card {
    background: linear-gradient(145deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.01) 100%);
    border: 1px solid rgba(255,255,255,0.05);
    transition: all 0.3s ease;
}
.stat-card:hover {
    border-color: rgba(45, 212, 191, 0.3);
    transform: translateY(-2px);
}

.chaos-log-item {
    border-left: 2px solid transparent;
    transition: all 0.2s;
}
.chaos-log-item:hover { background: rgba(255,255,255,0.02); }
.chaos-negative { border-left-color: var(--accent-red); }
.chaos-positive { border-left-color: var(--accent-teal); }

/* --- RUPEE BHAI CHAT STYLES --- */
.rupee-bhai-panel {
    background: radial-gradient(circle at top right, rgba(59, 130, 246, 0.05), rgba(13, 17, 23, 0.95));
    border: 1px solid rgba(59, 130, 246, 0.2);
    display: flex;
    flex-direction: column;
}

.chat-message {
    max-width: 85%;
    margin-bottom: 12px;
    padding: 10px 14px;
    border-radius: 12px;
    font-size: 0.85rem;
    line-height: 1.4;
    animation: fadeIn 0.3s ease-out;
}
@keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }

.bot-msg {
    background: rgba(255, 255, 255, 0.05);
    color: #e2e8f0;
    border-top-left-radius: 2px;
    align-self: flex-start;
    border-left: 2px solid var(--accent-blue);
}

.user-msg {
    background: rgba(59, 130, 246, 0.15);
    color: #fff;
    border-bottom-right-radius: 2px;
    align-self: flex-end;
    border-right: 2px solid var(--accent-blue);
}

.typing-dot {
    width: 6px;
    height: 6px; background: #94a3b8; border-radius: 50%;
    animation: typing 1.4s infinite ease-in-out both;
}
.typing-dot:nth-child(1) { animation-delay: -0.32s; }
.typing-dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes typing { 0%, 80%, 100% { transform: scale(0); } 40% { transform: scale(1); } }

/* Quote Card */
.quote-card {
    background: radial-gradient(circle at top right, rgba(45, 212, 191, 0.1), rgba(13, 17, 23, 0.8));
    border: 1px solid rgba(45, 212, 191, 0.2);
}

