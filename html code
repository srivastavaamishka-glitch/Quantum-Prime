<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Artha Twin AI | Login & Calibration</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="final.css">
</head>
<body class="antialiased min-h-screen relative flex flex-col items-center justify-center">

    <canvas id="bg-canvas"></canvas>
    
    <div id="login-view" class="view-section w-full max-w-[1100px] p-6 opacity-0">
        <div class="axis-line"></div>
        <div class="glass-panel rounded-[32px] overflow-hidden grid grid-cols-1 lg:grid-cols-2">
            
            <div class="hidden lg:flex flex-col justify-between p-16 border-r border-white/5 relative">
                <div class="z-10">
                    <div id="logo-wrap" class="flex items-center gap-4 mb-12">
                        <div class="relative flex items-center justify-center">
                            <div id="logo-l" class="logo-part text-3xl font-bold text-white translate-x-[-20px] opacity-0">A</div>
                            <div class="dna-helix mx-1">
                                <svg width="24" height="40" viewBox="0 0 24 40" fill="none">
                                    <path d="M4 4C4 4 20 12 20 20C20 28 4 36 4 36" stroke="#2dd4bf" stroke-width="3" stroke-linecap="round"/>
                                    <path d="M20 4C20 4 4 12 4 20C4 28 20 36 20 36" stroke="#3b82f6" stroke-width="3" stroke-linecap="round" opacity="0.5"/>
                                </svg>
                            </div>
                            <div id="logo-r" class="logo-part text-3xl font-bold text-slate-400 translate-x-[20px] opacity-0">A</div>
                        </div>
                        <span class="text-xl font-bold tracking-[0.2em] uppercase text-white">Artha Twin</span>
                    </div>

                    <h1 class="text-4xl xl:text-5xl font-bold leading-tight text-white mb-6" id="main-title">
                        Your Wealth, <br/> <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-blue-500">Perfectly Mirrored.</span>
                    </h1>
                    <p class="text-slate-400 text-lg leading-relaxed max-w-sm">
                        Experience high-fidelity financial forecasting through the world's most advanced digital twin architecture.
                    </p>
                </div>

                <div class="relative z-10 p-6 rounded-2xl bg-white/5 border border-white/10" id="sim-preview">
                    <div class="flex justify-between items-center mb-6">
                        <div class="text-xs font-mono text-teal-400 uppercase tracking-widest">System Live</div>
                        <div class="h-2 w-2 rounded-full bg-teal-400 animate-ping"></div>
                    </div>
                    <div class="space-y-4">
                        <div class="h-1 w-full bg-white/5 rounded-full overflow-hidden">
                            <div class="h-full bg-teal-400/50 w-2/3" id="progress-bar"></div>
                        </div>
                        <div class="flex justify-between font-mono text-[10px] text-slate-500">
                            <span>SYNCING REAL-TIME DATA</span>
                            <span>89% COMPLETE</span>
                        </div>
                    </div>
                </div>
            </div>
 <div class="p-10 lg:p-20 bg-black/20 flex flex-col justify-center">
                <div class="max-w-sm mx-auto w-full">
                    <div class="mb-12">
                        <h2 class="text-3xl font-bold text-white mb-2">Welcome Back</h2>
                        <p class="text-slate-500">Enter your credentials to mirror your reality.</p>
                    </div>

                    <form id="loginForm" class="space-y-6">
                        <div class="space-y-2">
                            <label class="text-[10px] uppercase tracking-[0.2em] font-bold text-slate-500 ml-1">
                                Identity Access<span class="required-indicator">*</span>
                            </label>
                            <div class="input-container">
                                <input type="email" placeholder="Email or Username" required
                                    class="w-full bg-transparent px-5 py-4 text-white transition-all border border-white/10 rounded-xl placeholder:text-slate-700 outline-none">
                            </div>
                        </div
 <div class="space-y-2">
                            <div class="flex justify-between items-center">
                                <label class="text-[10px] uppercase tracking-[0.2em] font-bold text-slate-500 ml-1">
                                    Secure Key<span class="required-indicator">*</span>
                                </label>
                                <a href="#" class="text-[10px] uppercase font-bold text-teal-500 hover:text-teal-400">Recovery</a>
                            </div>
                            <div class="input-container">
                                <input type="password" placeholder="••••••••" required
                                    class="w-full bg-transparent px-5 py-4 text-white transition-all border border-white/10 rounded-xl placeholder:text-slate-700 outline-none">
                            </div>
                        </div>

                        <div class="flex items-center gap-3 ml-1">
                            <input type="checkbox" id="keep-logged" class="custom-checkbox">
                            <label for="keep-logged" class="text-xs text-slate-500 font-medium cursor-pointer hover:text-slate-300 transition-colors">
                                Keep logged in for 30 days
                            </label>
                        </div>
<button type="submit" id="submitBtn"
                            class="btn-scan w-full py-5 bg-gradient-to-r from-teal-500 to-blue-600 text-white font-bold rounded-xl shadow-xl shadow-teal-500/20 hover:shadow-teal-500/40 transition-all active:scale-[0.98] uppercase tracking-widest text-sm">
                            Initialize Sync
                        </button>
                    </form>

                    <div class="mt-8 pt-8 border-t border-white/5">
                        <button class="group flex items-center justify-center gap-3 w-full py-4 rounded-xl border border-white/10 hover:bg-white/5 transition-all mb-6">
                            <svg class="w-5 h-5 group-hover:rotate-[360deg] transition-transform duration-700" viewBox="0 0 24 24"><path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.26.81-.58z"/><path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
                            <span class="text-xs font-bold uppercase tracking-widest text-slate-400">Sync with Google</span>
                        </button>

                        <p class="text-center text-xs text-slate-500 font-medium">
                            Don't have a twin yet?
                            <a href="#" class="text-teal-400 hover:text-teal-300 font-bold ml-1 underline decoration-teal-400/30 underline-offset-4 transition-all">Start Simulation</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="setup-view" class="view-section hidden-view w-full max-w-4xl p-6">
        <nav class="w-full flex justify-between items-center py-6 mb-10">
            <div class="flex items-center gap-3">
                <svg width="20" height="32" viewBox="0 0 24 40" fill="none">
                    <path d="M4 4C4 4 20 12 20 20C20 28 4 36 4 36" stroke="#2dd4bf" stroke-width="3" stroke-linecap="round"/>
                    <path d="M20 4C20 4 4 12 4 20C4 28 20 36 20 36" stroke="#3b82f6" stroke-width="3" stroke-linecap="round" opacity="0.5"/>
                </svg>
                <span class="text-lg font-bold tracking-[0.2em] uppercase text-white">Artha Twin</span>
            </div>
            <div class="flex items-center gap-4">
                <div class="text-[10px] font-mono text-teal-400 uppercase tracking-widest border border-teal-400/30 px-3 py-1 rounded-full bg-teal-400/5">
                    Calibration Mode
                </div>
            </div>
        </nav>
<div class="mb-12 relative px-4">
            <div class="step-line"></div>
            <div class="step-active-line" style="width: 0%"></div>
            <div class="flex justify-between relative">
                <div class="flex flex-col items-center gap-2"><div class="step-dot active" data-step="1"></div><span class="text-[10px] uppercase tracking-wider text-teal-400">Core ID</span></div>
                <div class="flex flex-col items-center gap-2"><div class="step-dot" data-step="2"></div><span class="text-[10px] uppercase tracking-wider text-slate-500">Inflow</span></div>
                <div class="flex flex-col items-center gap-2"><div class="step-dot" data-step="3"></div><span class="text-[10px] uppercase tracking-wider text-slate-500">Outflow</span></div>
                <div class="flex flex-col items-center gap-2"><div class="step-dot" data-step="4"></div><span class="text-[10px] uppercase tracking-wider text-slate-500">Assets</span></div>
                <div class="flex flex-col items-center gap-2"><div class="step-dot" data-step="5"></div><span class="text-[10px] uppercase tracking-wider text-slate-500">Friction</span></div>
            </div>
        </div>

        <form id="calibrationForm" class="glass-panel rounded-3xl p-8 md:p-12 relative overflow-hidden min-h-[500px]">
            
            <div id="step-1" class="section-active space-y-8">
                <div class="mb-8"><h2 class="text-3xl font-bold text-white mb-2">Initialize Core Identity</h2><p class="text-slate-400">Establish baseline temporal parameters.</p></div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="space-y-2"><label class="text-xs uppercase tracking-widest text-slate-500 font-bold">Current Age</label><input id="input-age" type="number" value="25" min="18" max="60" class="holo-input w-full p-4 rounded-xl text-white text-xl font-mono"></div>
                    <div class="space-y-2"><label class="text-xs uppercase tracking-widest text-slate-500 font-bold">Retirement Target</label><div class="flex items-center gap-4"><input id="input-retire" type="range" min="30" max="65" value="50" class="flex-1" oninput="this.nextElementSibling.innerText = this.value"><span class="text-white font-mono text-xl w-12 text-center bg-white/5 rounded p-1">50</span></div></div>
                </div>
            </div>

            <div id="step-2" class="section-hidden hidden space-y-8">
                <div class="mb-8"><h2 class="text-3xl font-bold text-white mb-2">Income Streams</h2><p class="text-slate-400">Map active cash flow sources.</p></div>
                <div class="space-y-4"><label class="text-xs uppercase tracking-widest text-slate-500 font-bold">Monthly In-hand Salary</label><div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 font-mono">₹</span><input id="input-salary" type="number" value="85000" class="holo-input w-full p-4 pl-10 rounded-xl text-white text-xl font-mono"></div></div>
                <div class="space-y-4"><label class="text-xs uppercase tracking-widest text-slate-500 font-bold">Annual Bonus</label><div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 font-mono">₹</span><input id="input-bonus" type="number" value="100000" class="holo-input w-full p-4 pl-10 rounded-xl text-white text-xl font-mono"></div></div>
            </div>

            <div id="step-3" class="section-hidden hidden space-y-8">
                <div class="mb-8"><h2 class="text-3xl font-bold text-white mb-2">Burn Rate</h2><p class="text-slate-400">Analyze lifestyle sustainability.</p></div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="space-y-2"><label class="text-xs uppercase tracking-widest text-slate-500 font-bold">Rent & Utilities</label><div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 font-mono">₹</span><input id="input-rent" type="number" value="25000" class="holo-input w-full p-4 pl-10 rounded-xl text-white text-xl font-mono"></div></div>
                    <div class="space-y-2"><label class="text-xs uppercase tracking-widest text-slate-500 font-bold">Lifestyle</label><div class="relative"><span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 font-mono">₹</span><input id="input-lifestyle" type="number" value="15000" class="holo-input w-full p-4 pl-10 rounded-xl text-white text-xl font-mono"></div></div>
                </div>
            </div>

            <div id="step-4" class="section-hidden hidden space-y-8">
                <div class="mb-8"><h2 class="text-3xl font-bold text-white mb-2">Existing Corpus</h2><p class="text-slate-400">Input current holdings.</p></div>
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-2"><label class="text-xs uppercase text-slate-500 font-bold">Investments</label><input id="input-assets" type="number" value="500000" class="holo-input w-full p-3 rounded-xl text-white font-mono"></div>
                </div>
            </div>

             <div id="step-5" class="section-hidden hidden space-y-8">
                <div class="mb-8"><h2 class="text-3xl font-bold text-white mb-2">Friction Points</h2><p class="text-slate-400">Identify active financial leaks to simulate impact.</p></div>
                <div class="grid grid-cols-1 gap-4">
                    <label class="cursor-pointer">
                        <input type="radio" name="mismanagement" value="none" checked class="peer sr-only">
                        <div class="p-4 rounded-xl border border-white/10 bg-white/5 peer-checked:bg-teal-500/20 peer-checked:border-teal-400 peer-checked:text-teal-400 text-slate-400 transition-all hover:bg-white/10 flex items-center justify-between">
                            <div><div class="font-bold">Optimized</div><div class="text-[10px] opacity-70">Finances are under control</div></div>
                            <div class="w-4 h-4 rounded-full border border-white/30 peer-checked:bg-teal-400"></div>
                        </div>
                    </label>
                    <label class="cursor-pointer">
                        <input type="radio" name="mismanagement" value="creep" class="peer sr-only">
                        <div class="p-4 rounded-xl border border-white/10 bg-white/5 peer-checked:bg-teal-500/20 peer-checked:border-teal-400 peer-checked:text-teal-400 text-slate-400 transition-all hover:bg-white/10 flex items-center justify-between">
                            <div><div class="font-bold">Lifestyle Creep</div><div class="text-[10px] opacity-70">Expenses rising to match income</div></div>
                            <div class="w-4 h-4 rounded-full border border-white/30 peer-checked:bg-teal-400"></div>
                        </div>
                    </label>
                    <label class="cursor-pointer">
                        <input type="radio" name="mismanagement" value="debt" class="peer sr-only">
                        <div class="p-4 rounded-xl border border-white/10 bg-white/5 peer-checked:bg-teal-500/20 peer-checked:border-teal-400 peer-checked:text-teal-400 text-slate-400 transition-all hover:bg-white/10 flex items-center justify-between">
                            <div><div class="font-bold">Debt Heavy</div><div class="text-[10px] opacity-70">High EMI burden (>40% of income)</div></div>
                            <div class="w-4 h-4 rounded-full border border-white/30 peer-checked:bg-teal-400"></div>
                        </div>
                    </label>
                    <label class="cursor-pointer">
                        <input type="radio" name="mismanagement" value="impulse" class="peer sr-only">
                        <div class="p-4 rounded-xl border border-white/10 bg-white/5 peer-checked:bg-teal-500/20 peer-checked:border-teal-400 peer-checked:text-teal-400 text-slate-400 transition-all hover:bg-white/10 flex items-center justify-between">
                            <div><div class="font-bold">Impulse Spending</div><div class="text-[10px] opacity-70">Frequent unplanned large purchases</div></div>
                            <div class="w-4 h-4 rounded-full border border-white/30 peer-checked:bg-teal-400"></div>
                        </div>
                    </label>
                </div>
                <div class="mt-8 pt-6 border-t border-white/10">
                     <button type="button" class="w-full py-5 bg-gradient-to-r from-teal-500 to-blue-600 text-white font-bold rounded-xl shadow-xl shadow-teal-500/20 hover:shadow-teal-500/40 transition-all active:scale-[0.98] uppercase tracking-widest text-sm" onclick="startSimulation()">
                     Generate Digital Twin
                    </button>
                </div>
            </div>
<div class="absolute bottom-8 right-8 flex gap-4" id="nav-btns">
                <button type="button" id="prevBtn" class="hidden px-6 py-2 rounded-lg border border-white/10 text-slate-400 hover:bg-white/5 transition-all text-xs uppercase tracking-wider font-bold">Back</button>
                <button type="button" id="nextBtn" class="px-6 py-2 rounded-lg bg-white/10 text-teal-400 border border-teal-400/30 hover:bg-teal-400/10 transition-all text-xs uppercase tracking-wider font-bold">Next Section</button>
            </div>
        </form>
    </div>

    <div id="dashboard-view" class="view-section hidden-view w-full max-w-[1200px] p-6 h-screen flex flex-col">
        <nav class="w-full flex justify-between items-center py-4 mb-6">
            <div class="flex items-center gap-3">
                <svg width="20" height="32" viewBox="0 0 24 40" fill="none"><path d="M4 4C4 4 20 12 20 20C20 28 4 36 4 36" stroke="#2dd4bf" stroke-width="3" stroke-linecap="round"/><path d="M20 4C20 4 4 12 4 20C4 28 20 36 20 36" stroke="#3b82f6" stroke-width="3" stroke-linecap="round" opacity="0.5"/></svg>
                <span class="text-lg font-bold tracking-[0.2em] uppercase text-white">Artha Twin // <span class="text-teal-400">Live Simulation</span></span>
            </div>
            <button onclick="location.reload()" class="text-xs font-mono text-slate-400 hover:text-white uppercase">Reset Core</button>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 flex-1 min-h-0">
            
            <div class="lg:col-span-2 glass-panel rounded-3xl p-6 flex flex-col min-h-0">
                <div class="flex justify-between items-start mb-6">
                    <div>
                        <h3 class="text-slate-400 text-xs uppercase tracking-widest font-bold">Net Worth Projection</h3>
                        <div class="flex items-baseline gap-2 mt-1">
                            <span id="stat-final-nw" class="text-3xl font-bold text-white font-mono">₹0 Cr</span>
                            <span class="text-xs text-teal-400 bg-teal-400/10 px-2 py-0.5 rounded">Inflation Adj.</span>
                        </div>
                    </div>
                    <div class="flex gap-4 text-xs font-mono text-slate-500">
                        <div class="flex items-center gap-2"><div class="w-3 h-3 bg-slate-600 rounded-sm"></div>Linear Path</div>
                        <div class="flex items-center gap-2"><div class="w-3 h-3 bg-teal-500 rounded-sm"></div>Chaos Twin</div>
                    </div>
                </div>

                <div class="grid grid-cols-3 gap-4 mb-6">
                    <div class="p-4 rounded-2xl bg-white/5 border border-white/5 flex flex-col justify-center">
                        <p class="text-[10px] text-slate-500 uppercase font-bold mb-1">Monthly Surplus</p>
                        <p id="stat-surplus" class="text-lg text-white font-mono font-bold">--</p>
                    </div>
                    <div class="p-4 rounded-2xl bg-white/5 border border-white/5 flex flex-col justify-center">
                        <p class="text-[10px] text-slate-500 uppercase font-bold mb-1">Savings Rate</p>
                        <p id="stat-savings-rate" class="text-lg text-white font-mono font-bold">--</p>
                    </div>
                    <div class="p-4 rounded-2xl bg-white/5 border border-white/5 flex flex-col justify-center">
                        <p class="text-[10px] text-slate-500 uppercase font-bold mb-1">Survival Runway</p>
                        <p id="stat-runway" class="text-lg text-white font-mono font-bold">--</p>
                    </div>
                </div>

                <div class="flex-1 relative min-h-[300px]">
                    <canvas id="simChart"></canvas>
                </div>
            </div>

            <div class="flex flex-col gap-4 min-h-0">
                
                <div class="glass-panel rounded-3xl p-4 grid grid-cols-2 gap-4 h-24">
                    <div class="stat-card p-3 rounded-xl flex flex-col justify-center">
                        <p class="text-[10px] text-slate-500 uppercase font-bold">Wealth @ 60</p>
                        <p id="stat-nw-60" class="text-lg text-white font-mono font-bold mt-1">--</p>
                    </div>
                    <div class="stat-card p-3 rounded-xl flex flex-col justify-center">
                        <p class="text-[10px] text-slate-500 uppercase font-bold">Safety Score</p>
                        <p id="stat-safety" class="text-lg text-emerald-400 font-mono font-bold mt-1">--</p>
                    </div>
                </div>
<div class="glass-panel rupee-bhai-panel rounded-3xl flex-1 flex flex-col min-h-0 overflow-hidden relative">
                    <div class="p-4 border-b border-blue-500/20 bg-blue-900/10 flex justify-between items-center">
                        <div class="flex items-center gap-2">
                            <div class="w-2 h-2 bg-blue-400 rounded-full animate-pulse"></div>
                            <span class="text-xs font-bold text-blue-400 uppercase tracking-widest">Rupee Bhai AI</span>
                        </div>
                        <span id="market-status" class="text-[10px] text-slate-400 font-mono border border-slate-700 px-2 py-0.5 rounded">Simulating Market...</span>
                    </div>

                    <div id="rupee-bhai-chat" class="flex-1 overflow-y-auto p-4 space-y-3 scrollbar-thin scrollbar-thumb-blue-900 scrollbar-track-transparent">
                        </div>

                    <div class="p-3 border-t border-white/5 bg-black/20">
                        <form id="chatForm" class="flex gap-2">
                            <input type="text" id="chatInput" placeholder="Ask Rupee Bhai (e.g. 'Should I buy gold?')" 
                                class="flex-1 bg-white/5 border border-white/10 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-blue-500/50 transition-all placeholder:text-slate-600">
                            <button type="submit" class="bg-blue-600/80 hover:bg-blue-500 text-white rounded-xl px-4 py-2 transition-all">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
                            </button>
                        </form>
                    </div>
                </div>

                <div class="glass-panel rounded-3xl p-3 h-32 flex flex-col">
                    <div class="flex justify-between items-center mb-2">
                        <h3 class="text-slate-500 text-[10px] uppercase font-bold">Chaos Events</h3>
                        <span class="text-[8px] text-slate-600">LOG</span>
                    </div>
                    <div id="chaos-log" class="flex-1 overflow-y-auto space-y-2 pr-1 font-mono text-[10px]">
                        </div>
                </div>

                <div class="quote-card rounded-2xl p-4">
                    <p class="text-[10px] text-teal-400 uppercase font-bold tracking-widest mb-2">Quote of the Day</p>
                    <p id="daily-quote" class="text-xs text-slate-300 italic font-medium">"..."</p>
                    <p id="quote-author" class="text-[10px] text-slate-500 mt-2 text-right font-mono tracking-wide">- ...</p>
                </div>
            </div>
        </div>
    </div>
    
    <script src="final.js"></script>
</body>
</html>

