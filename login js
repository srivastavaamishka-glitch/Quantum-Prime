// --- PARTICLE BACKGROUND ---
const canvas = document.getElementById('bg-canvas');
const ctx = canvas.getContext('2d');
let particles = [];
let width, height;

function resize() { width = canvas.width = window.innerWidth; height = canvas.height = window.innerHeight; }
class Particle {
    constructor() { this.reset(); }
    reset() {
        this.x = Math.random() * (width / 2); this.y = Math.random() * height;
        this.vx = (Math.random() - 0.5) * 0.3; this.vy = (Math.random() - 0.5) * 0.3;
        this.size = Math.random() * 2; this.alpha = Math.random() * 0.3;
    }
    update() {
        this.x += this.vx; this.y += this.vy;
        if (this.x < 0 || this.x > width/2 || this.y < 0 || this.y > height) this.reset();
    }
    draw() {
        ctx.fillStyle = `rgba(45, 212, 191, ${this.alpha})`;
        ctx.beginPath(); ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2); ctx.fill();
        ctx.beginPath(); ctx.arc(width - this.x, this.y, this.size, 0, Math.PI * 2); ctx.fill();
    }
}
function initParticles() { particles = []; for(let i=0; i<60; i++) particles.push(new Particle()); }
function animateParticles() { ctx.clearRect(0, 0, width, height); particles.forEach(p => { p.update(); p.draw(); }); requestAnimationFrame(animateParticles); }
window.addEventListener('load', () => { resize(); initParticles(); animateParticles(); });
window.addEventListener('resize', resize);

// --- GSAP ENTRANCE ---
window.addEventListener('load', () => {
    const tl = gsap.timeline({ defaults: { ease: "expo.out" } });
    tl.to("#login-view", { opacity: 1, duration: 1 });
    tl.to("#logo-l", { x: 0, opacity: 1, duration: 1.5 }, "-=0.5");
    tl.to("#logo-r", { x: 0, opacity: 1, duration: 1.5 }, "-=1.5");
    tl.from("#main-title", { y: 30, opacity: 0, duration: 1 }, "-=1");
    gsap.to("#progress-bar", { width: "95%", duration: 4, repeat: -1, yoyo: true, ease: "sine.inOut" });
});
// --- VIEW SWITCHING ---
function switchView(fromId, toId, callback) {
    const wipe = document.createElement('div');
    wipe.style.cssText = `position: fixed; top: 0; left: 0; width: 2px; height: 100%; background: var(--accent-teal); box-shadow: 0 0 40px var(--accent-teal); z-index: 100; pointer-events: none;`;
    document.body.appendChild(wipe);
    
    gsap.to(wipe, {
        width: "100%", left: "100%", duration: 1.5, ease: "power4.inOut",
        onComplete: () => {
            document.getElementById(fromId).classList.add('hidden-view');
            const toEl = document.getElementById(toId);
            toEl.classList.remove('hidden-view');
            if (fromId === 'login-view') document.querySelector('.axis-line').style.opacity = '0';
            gsap.to(wipe, { opacity: 0, duration: 0.5 });
            gsap.to(toEl, { opacity: 1, duration: 0.8 });
            if(callback) callback();
        }
    });
}

document.getElementById('loginForm').addEventListener('submit', (e) => {
    e.preventDefault();
    document.getElementById('submitBtn').innerHTML = "ESTABLISHING MIRROR...";
    switchView('login-view', 'setup-view', () => {
            gsap.from("#setup-view nav", { y: -20, opacity: 0, duration: 1, delay: 0.2 });
            gsap.from("#setup-view .glass-panel", { y: 30, opacity: 0, duration: 1, delay: 0.4 });
    });
});
// --- SETUP FORM LOGIC ---
let currentStep = 1;
const totalSteps = 5;
function updateUI() {
    const progress = ((currentStep - 1) / (totalSteps - 1)) * 100;
    document.querySelector('.step-active-line').style.width = `${progress}%`;
    document.querySelectorAll('.step-dot').forEach(dot => {
        const step = parseInt(dot.dataset.step);
        dot.classList.remove('active', 'completed');
        if (step === currentStep) dot.classList.add('active');
        if (step < currentStep) dot.classList.add('completed');
        const label = dot.nextElementSibling;
        label.classList.toggle('text-teal-400', step <= currentStep);
        label.classList.toggle('text-slate-500', step > currentStep);
    });
    for (let i = 1; i <= totalSteps; i++) {
        const el = document.getElementById(`step-${i}`);
        if (i === currentStep) {
            el.classList.remove('hidden');
            el.classList.add('block'); // ensure visibility
            // Simple animation
            gsap.fromTo(el, { opacity: 0, x: 20 }, { opacity: 1, x: 0, duration: 0.5 });
        } else {
            el.classList.add('hidden');
            el.classList.remove('block');
        }
    }
    document.getElementById('prevBtn').classList.toggle('hidden', currentStep === 1);
    
    // Toggle Next/Generate button based on last step
    if (currentStep === totalSteps) { 
        document.getElementById('nav-btns').style.display = 'none'; 
    } else { 
        document.getElementById('nav-btns').style.display = 'flex'; 
    }
}

