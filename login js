function runSimulation() {
    // 1. Gather Inputs
    const currentAge = parseInt(document.getElementById('input-age').value);
    const retirementAge = parseInt(document.getElementById('input-retire').value);
    const salary = parseInt(document.getElementById('input-salary').value);
