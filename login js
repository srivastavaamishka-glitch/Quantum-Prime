// --- SETUP FORM LOGIC ---
let currentStep = 1;
const totalSteps = 5;
function updateUI() {
    const progress = ((currentStep - 1) / (totalSteps - 1)) * 100;
    document.querySelector('.step-active-line').style.width = `${progress}%`;
    document.querySelectorAll('.step-dot').forEach(dot => {
        const step = parseInt(dot.dataset.step);
        dot.classList.remove('active', 'completed');
        if (step === currentStep) dot.classList.add('active');
        if (step < currentStep) dot.classList.add('completed');
        const label = dot.nextElementSibling;
        label.classList.toggle('text-teal-400', step <= currentStep);
        label.classList.toggle('text-slate-500', step > currentStep);
    });
    for (let i = 1; i <= totalSteps; i++) {
        const el = document.getElementById(`step-${i}`);
        if (i === currentStep) {
            el.classList.remove('hidden');
            el.classList.add('block'); // ensure visibility
            // Simple animation
            gsap.fromTo(el, { opacity: 0, x: 20 }, { opacity: 1, x: 0, duration: 0.5 });
        } else {
            el.classList.add('hidden');
            el.classList.remove('block');
        }
    }
    document.getElementById('prevBtn').classList.toggle('hidden', currentStep === 1);
    
    // Toggle Next/Generate button based on last step
    if (currentStep === totalSteps) { 
        document.getElementById('nav-btns').style.display = 'none'; 
    } else { 
        document.getElementById('nav-btns').style.display = 'flex'; 
    }
}
// Ensure initial state
updateUI();

document.getElementById('nextBtn').addEventListener('click', () => { if (currentStep < totalSteps) { currentStep++; updateUI(); } });
document.getElementById('prevBtn').addEventListener('click', () => { if (currentStep > 1) { currentStep--; updateUI(); } });

// --- RUPEE BHAI LOGIC ---
const RupeeBhai = {
    chatContainer: null,
    marketCondition: "Neutral",
    
    init: function(data) {
        this.chatContainer = document.getElementById('rupee-bhai-chat');
        this.chatContainer.innerHTML = ''; // Clear chat
        
        // 1. Fixed Market Sentiment (No Randomness)
        this.marketCondition = "Live Simulation"; 
        document.getElementById('market-status').innerText = `Market: ${this.marketCondition}`;
        
        // 2. Initial Analysis
        setTimeout(() => this.addBotMessage(`Namaste! I am Rupee Bhai. I've analyzed your financial DNA.`), 500);
        setTimeout(() => this.generateAnalysis(data), 1500);
    },

    addBotMessage: function(text) {
        const msgDiv = document.createElement('div');
        msgDiv.className = 'chat-message bot-msg';
        msgDiv.innerText = text;
        this.chatContainer.appendChild(msgDiv);
        this.scrollToBottom();
    },

    addUserMessage: function(text) {
        const msgDiv = document.createElement('div');
        msgDiv.className = 'chat-message user-msg';
        msgDiv.innerText = text;
        this.chatContainer.appendChild(msgDiv);
        this.scrollToBottom();
        
        // Show typing indicator then reply
        this.showTyping();
        setTimeout(() => {
            this.removeTyping();
            this.processQuery(text);
        }, 1500);
    },

    showTyping: function() {
        const typingDiv = document.createElement('div');
        typingDiv.id = 'typing-indicator';
        typingDiv.className = 'chat-message bot-msg flex gap-1 items-center';
        typingDiv.innerHTML = '<div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div>';
        this.chatContainer.appendChild(typingDiv);
        this.scrollToBottom();
    },

    removeTyping: function() {
        const el = document.getElementById('typing-indicator');
        if(el) el.remove();
    },

    scrollToBottom: function() {
        this.chatContainer.scrollTop = this.chatContainer.scrollHeight;
    },

    generateAnalysis: function(data) {
        let analysis = "";
        
        if (data.frictionType === 'debt') {
            analysis += "🚨 Critical: Your debt burden is suppressing compounding by ~30% in early years. Prioritize clearing high-interest loans immediately.";
        } else if (data.frictionType === 'creep') {
            analysis += "⚠️ Warning: Your lifestyle inflation (10%) is eating your future wealth. If unchecked, you'll miss your retirement target by 7 years.";
        } else if (data.frictionType === 'impulse') {
            analysis += "📉 Volatility: Impulse spending creates unpredictable dips. I recommend a '24-hour waiting rule' for purchases > ₹5k.";
        } else {
            analysis += "✅ Baseline: Your financials look healthy. Now focus on asset allocation to beat inflation.";
        }

        // Removed market context randomness checks since it's now stable
        analysis += "\n\nEnvironment: The simulation assumes standard historical volatility. Focus on long-term rupee cost averaging.";

        this.addBotMessage(analysis);
        this.addBotMessage("You can ask me about: SIPs, Gold, Debt Management, or Crypto.");
    },

    processQuery: function(text) {
        text = text.toLowerCase();
        let response = "I'm still learning intricacies of that. Try asking about SIP, Gold, or basic financial hygiene.";

        if (text.includes("sip") || text.includes("mutual fund")) {
            response = "SIPs are your best friend for rupee-cost averaging. In a " + this.marketCondition + ", consistent investing beats timing the market.";
        } else if (text.includes("gold")) {
            response = "Gold acts as a hedge against volatility. Consider Sovereign Gold Bonds (SGBs) for 2.5% extra interest over physical gold.";
        } else if (text.includes("crypto") || text.includes("bitcoin")) {
            response = "Crypto is highly volatile. If you must, limit it to <5% of your portfolio as 'play money'. Never use your emergency fund for it.";
        } else if (text.includes("debt") || text.includes("loan")) {
            response = "Use the 'Avalanche Method' (highest interest first) or 'Snowball Method' (smallest loan first). Just kill the debt before investing heavily.";
        } else if (text.includes("stock") || text.includes("market")) {
            response = "We are simulating a standard market cycle. Stick to your fundamentals and don't chase overvalued stocks.";
        } else if (text.includes("thank") || text.includes("hello") || text.includes("hi")) {
            response = "You're welcome! Let's keep your financial twin healthy.";
        }

        this.addBotMessage(response);
    }
};

// --- SIMULATION & CHAOS ENGINE ---
function startSimulation() {
    switchView('setup-view', 'dashboard-view', runSimulation);
}

function runSimulation() {
    // 1. Gather Inputs
    const currentAge = parseInt(document.getElementById('input-age').value);
    const retirementAge = parseInt(document.getElementById('input-retire').value);
    const salary = parseInt(document.getElementById('input-salary').value);
    const bonus = parseInt(document.getElementById('input-bonus').value);
    const monthlyRent = parseInt(document.getElementById('input-rent').value);
    const monthlyLifestyle = parseInt(document.getElementById('input-lifestyle').value);
    const expenses = (monthlyRent + monthlyLifestyle) * 12;
    let corpus = parseInt(document.getElementById('input-assets').value);
    const frictionType = document.querySelector('input[name="mismanagement"]:checked').value;
    
    // Financial Summary Calculations
    const monthlyTotalExpense = monthlyRent + monthlyLifestyle;
    const monthlySurplus = salary - monthlyTotalExpense;
    const savingsRate = Math.round((monthlySurplus / salary) * 100);
    const runwayMonths = Math.round(corpus / monthlyTotalExpense);
    let runwayDisplay = runwayMonths + " Months";
    if (runwayMonths > 24) runwayDisplay = (runwayMonths / 12).toFixed(1) + " Years";
// Update Summary UI
    const surplusEl = document.getElementById('stat-surplus');
    surplusEl.innerText = "₹" + monthlySurplus.toLocaleString('en-IN');
    surplusEl.className = `text-lg font-mono font-bold ${monthlySurplus > 0 ? 'text-emerald-400' : 'text-red-400'}`;

    const savingsEl = document.getElementById('stat-savings-rate');
    savingsEl.innerText = savingsRate + "%";
    savingsEl.className = `text-lg font-mono font-bold ${savingsRate > 20 ? 'text-emerald-400' : (savingsRate > 0 ? 'text-yellow-400' : 'text-red-400')}`;

    const runwayEl = document.getElementById('stat-runway');
    runwayEl.innerText = runwayDisplay;
    runwayEl.className = `text-lg font-mono font-bold ${runwayMonths > 6 ? 'text-emerald-400' : 'text-red-400'}`;

    
    const salaryGrowth = 0.10; // 10% annual
    let inflation = 0.07; // 7% annual
    const marketReturn = 0.12; // 12% annual
    const years = 80 - currentAge; // Sim until 80
    
    let linearCorpus = corpus;
    let linearData = [];
    let chaosData = [];
    let chaosLog = [];
    let labels = [];

    let annualIncome = (salary * 12) + bonus;
    let annualExpense = expenses;
    
    // Chaos Twin Setup
    let twinCorpus = corpus;
    let twinIncome = annualIncome;
    let twinExpense = annualExpense;

    for (let i = 0; i <= years; i++) {
        let age = currentAge + i;
        labels.push(age);
        
        // --- Linear Projection ---
        if (age < retirementAge) {
            let savings = Math.max(0, annualIncome - annualExpense);
            linearCorpus = (linearCorpus + savings) * (1 + marketReturn);
            annualIncome *= (1 + salaryGrowth);
            annualExpense *= (1 + 0.07);
        } else {
            linearCorpus = (linearCorpus - annualExpense) * (1 + (marketReturn - 0.02)); 
            annualExpense *= (1 + 0.07);
        }
        linearData.push(linearCorpus);

        // --- Chaos Engine ---
        let chaosReturn = marketReturn;
        let chaosEvent = null;
        const rand = Math.random();

        // Apply Friction Logic
        let currentInflation = inflation;
        let currentSavingsRatio = 1.0;
        
        if (frictionType === 'creep') currentInflation = 0.10;
        if (frictionType === 'debt' && i < 5) currentSavingsRatio = 0.7;
        if (frictionType === 'impulse' && rand > 0.7) twinExpense *= 1.15;

        if (age < retirementAge) {
            if (rand < 0.05) { 
                chaosReturn = -0.15;
                chaosEvent = { age, type: 'neg', msg: "Market Crash (-15%)" };
            } else if (rand < 0.08) { 
                twinExpense += 500000;
                chaosEvent = { age, type: 'neg', msg: "Medical Emergency (-5L)" };
            } else if (rand > 0.95) { 
                twinCorpus += 1000000;
                chaosEvent = { age, type: 'pos', msg: "Stock Option Windfall (+10L)" };
            }

            let savings = Math.max(0, twinIncome - twinExpense);
            savings *= currentSavingsRatio;

            twinCorpus = (twinCorpus + savings) * (1 + chaosReturn);
            twinIncome *= (1 + salaryGrowth);
            twinExpense *= (1 + currentInflation);
        } else {
            twinCorpus = (twinCorpus - twinExpense) * (1 + (marketReturn - 0.04)); 
            twinExpense *= (1 + currentInflation);
        }
        
        if (chaosEvent) chaosLog.push(chaosEvent);
        chaosData.push(Math.max(0, twinCorpus));
    }

    // 2. Render UI Stats
    const formatter = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumSignificantDigits: 3 });
    document.getElementById('stat-final-nw').innerText = formatter.format(linearData[linearData.length-1] / 10000000) + " Cr";
    
    const nwAt60Index = retirementAge - currentAge;
    const nwAt60 = linearData[nwAt60Index] || 0;
    document.getElementById('stat-nw-60').innerText = formatter.format(nwAt60 / 10000000) + " Cr";
    
    const coverageRatio = linearData[nwAt60Index] / (annualExpense * 20); 
    const score = Math.min(100, Math.round(coverageRatio * 100));
    document.getElementById('stat-safety').innerText = score + "/100";

    // 3. Render Chaos Log
    const logContainer = document.getElementById('chaos-log');
    logContainer.innerHTML = '';
    chaosLog.forEach(log => {
        const div = document.createElement('div');
        div.className = `chaos-log-item p-2 text-slate-400 ${log.type === 'neg' ? 'chaos-negative' : 'chaos-positive'}`;
        div.innerHTML = `<span class="font-bold text-white">Age ${log.age}:</span> ${log.msg}`;
        logContainer.appendChild(div);
    });
// 4. Initialize Rupee Bhai
    RupeeBhai.init({ frictionType, score });

    // 5. Update Quote of the Day
    const quotes = [
        { text: "Beware of little expenses. A small leak will sink a great ship.", author: "Benjamin Franklin" },
        { text: "It's not how much money you make, but how much money you keep.", author: "Robert Kiyosaki" },
        { text: "The stock market is designed to transfer money from the Active to the Patient.", author: "Warren Buffett" },
        { text: "Financial freedom is available to those who learn about it and work for it.", author: "Robert Kiyosaki" },
        { text: "Do not save what is left after spending, but spend what is left after saving.", author: "Warren Buffett" },
        { text: "Compound interest is the eighth wonder of the world. He who understands it, earns it... he who doesn't... pays it.", author: "Albert Einstein" }
    ];
    const q = quotes[Math.floor(Math.random() * quotes.length)];
    document.getElementById('daily-quote').innerText = `"${q.text}"`;
    document.getElementById('quote-author').innerText = `- ${q.author}`;

    // 6. Render Chart
    const ctxChart = document.getElementById('simChart').getContext('2d');
    if(window.myChart) window.myChart.destroy();
    window.myChart = new Chart(ctxChart, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [
                { label: 'Linear Trajectory', data: linearData, borderColor: '#475569', borderWidth: 2, borderDash: [5, 5], pointRadius: 0, tension: 0.4 },
                { label: 'Digital Twin (Chaos)', data: chaosData, borderColor: '#2dd4bf', backgroundColor: 'rgba(45, 212, 191, 0.1)', borderWidth: 3, fill: true, pointRadius: 0, tension: 0.4 }
            ]
        },
        options: {
            responsive: true, maintainAspectRatio: false, interaction: { intersect: false, mode: 'index' },
            plugins: { legend: { display: false }, tooltip: { backgroundColor: 'rgba(15, 23, 42, 0.9)', titleColor: '#2dd4bf', bodyFont: { family: 'JetBrains Mono' }, callbacks: { label: function(context) { return context.dataset.label + ": " + formatter.format(context.raw); } } } },
            scales: { x: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#64748b' } }, y: { display: false } }
        }
    });
}

