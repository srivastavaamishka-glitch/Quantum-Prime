document.addEventListener('DOMContentLoaded', () => {
    // 1. Setup Animations
    const tl = gsap.timeline({ defaults: { ease: "power3.out" } });
    tl.from(".logo-container", { y: -20, opacity: 0, duration: 1 })
      .from(".hero-text h1", { y: 30, opacity: 0, duration: 0.8 }, "-=0.5")
      .from(".login-card", { x: 50, opacity: 0, duration: 1 }, "-=0.5");

    // 2. Infinite Ring Rotation
    gsap.to(".ring-1", { rotationX: 360, rotationY: 180, duration: 20, repeat: -1, ease: "none" });
    gsap.to(".ring-2", { rotationX: -360, rotationZ: 100, duration: 25, repeat: -1, ease: "none" });
    gsap.to(".ring-3", { rotationY: 360, duration: 30, repeat: -1, ease: "none" });
    gsap.to(".ring-4", { rotationZ: -360, duration: 40, repeat: -1, ease: "none" });

    // 3. Typing Effect
    const textEl = document.getElementById('typing-text');
    const words = ["PREDICT", "PLAN", "GROW", "SECURE"];
    let [wIdx, cIdx, isDel] = [0, 0, false];
    const type = () => {
        const current = words[wIdx];
        if (isDel) cIdx--; else cIdx++;
        textEl.textContent = current.substring(0, cIdx);
        let speed = isDel ? 50 : 150;
        if (!isDel && cIdx === current.length) { isDel = true; speed = 1500; }
        else if (isDel && cIdx === 0) { isDel = false; wIdx = (wIdx + 1) % words.length; speed = 500; }
        setTimeout(type, speed);
    };
    type();

    // 4. Form Submit Logic
    document.getElementById('loginForm').addEventListener('submit', (e) => {
        e.preventDefault();
        const btn = document.querySelector('.btn-primary');
        const orgText = btn.innerHTML;
        btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> PROCESSING...';
        gsap.to(btn, { x: [-5, 5, -5, 5, 0], duration: 0.4 });
        setTimeout(() => { alert("Backend Connected! Redirecting..."); btn.innerHTML = orgText; }, 2000);
    });
});
