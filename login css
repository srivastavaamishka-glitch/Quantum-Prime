:root {
    --accent-teal: #2dd4bf;
    --accent-blue: #3b82f6;
    --bg-dark: #0a0c10;
}

body {
    font-family: 'Inter', sans-serif;
    background-color: var(--bg-dark);
    overflow-x: hidden;
    color: #e2e8f0;
}

/* --- SHARED STYLES --- */
#bg-canvas {
    position: fixed;
    top: 0; left: 0;
    z-index: -1;
}

.glass-panel {
    background: rgba(13, 17, 23, 0.7);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
}

/* --- LOGIN SPECIFIC STYLES --- */
.axis-line {
    position: fixed;
    left: 50%; top: 0;
    width: 1px; height: 100%;
    background: linear-gradient(to bottom, transparent, rgba(45, 212, 191, 0.1), transparent);
    z-index: 0;
    transition: opacity 0.5s;
}

.input-container {
    position: relative;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 12px;
    overflow: hidden;
}

.input-container::before {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 100%; height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent-teal));
    transition: 0.5s;
}

.input-container:focus-within::before { left: 100%; }

.logo-part { transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
.dna-helix { animation: pulse 3s infinite ease-in-out; }

@keyframes pulse {
    0%, 100% { filter: drop-shadow(0 0 2px var(--accent-teal)); opacity: 0.7; }
    50% { filter: drop-shadow(0 0 12px var(--accent-teal)); opacity: 1; }
}

.btn-scan { position: relative; overflow: hidden; }
.btn-scan::after {
    content: ""; position: absolute;
    top: -50%; left: -50%;
    width: 200%; height: 200%;
    background: linear-gradient(0deg, transparent, rgba(45, 212, 191, 0.1), transparent);
    transform: rotate(45deg);
    transition: 0.5s;
    pointer-events: none;
}
.btn-scan:hover::after { left: 100%; top: 100%; }

.required-indicator { color: var(--accent-teal); margin-left: 4px; }

.custom-checkbox {
    appearance: none; width: 16px; height: 16px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px; background: rgba(255, 255, 255, 0.05);
    cursor: pointer; position: relative; transition: all 0.3s;
}
.custom-checkbox:checked { background: var(--accent-teal); border-color: var(--accent-teal); }
.custom-checkbox:checked::after {
    content: '✓'; position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%); color: black; font-size: 10px; font-weight: bold;
}

/* --- SETUP/CALIBRATION SPECIFIC STYLES --- */
.holo-input {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
}
.holo-input:focus {
    background: rgba(45, 212, 191, 0.05);
    border-color: var(--accent-teal);
    box-shadow: 0 0 15px rgba(45, 212, 191, 0.1);
    outline: none;
}

.step-line {
    position: absolute; top: 50%; left: 0;
    width: 100%; height: 2px;
    background: rgba(255, 255, 255, 0.1); z-index: 0;
}
.step-active-line {
    position: absolute; top: 50%; left: 0; height: 2px;
    background: var(--accent-teal); z-index: 0; transition: width 0.5s ease;
}
.step-dot {
    width: 12px; height: 12px; background: var(--bg-dark);
    border: 2px solid rgba(255, 255, 255, 0.3); border-radius: 50%;
    position: relative; z-index: 10; transition: all 0.3s ease;
}
.step-dot.active { background: var(--accent-teal); border-color: var(--accent-teal); box-shadow: 0 0 10px var(--accent-teal); }
.step-dot.completed { background: var(--accent-teal); border-color: var(--accent-teal); }

input[type=range] { -webkit-appearance: none; width: 100%; background: transparent; }
input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none; height: 20px; width: 20px;
    border-radius: 50%; background: var(--accent-teal); cursor: pointer;
    margin-top: -8px; box-shadow: 0 0 10px rgba(45, 212, 191, 0.5);
}
input[type=range]::-webkit-slider-runnable-track {
    width: 100%; height: 4px; cursor: pointer;
    background: rgba(255, 255, 255, 0.1); border-radius: 2px;
}

.view-section {
    transition: opacity 0.5s ease;
}
.hidden-view {
    display: none;
    opacity: 0;
}
