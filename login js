    generateAnalysis: function(data) {
        let analysis = "";
        
        if (data.frictionType === 'debt') {
            analysis += "🚨 Critical: Your debt burden is suppressing compounding by ~30% in early years. Prioritize clearing high-interest loans immediately.";
        } else if (data.frictionType === 'creep') {
            analysis += "⚠️ Warning: Your lifestyle inflation (10%) is eating your future wealth. If unchecked, you'll miss your retirement target by 7 years.";
        } else if (data.frictionType === 'impulse') {
            analysis += "📉 Volatility: Impulse spending creates unpredictable dips. I recommend a '24-hour waiting rule' for purchases > ₹5k.";
        } else {
            analysis += "✅ Baseline: Your financials look healthy. Now focus on asset allocation to beat inflation.";
        }

        // Removed market context randomness checks since it's now stable
        analysis += "\n\nEnvironment: The simulation assumes standard historical volatility. Focus on long-term rupee cost averaging.";

        this.addBotMessage(analysis);
        this.addBotMessage("You can ask me about: SIPs, Gold, Debt Management, or Crypto.");
    },

    processQuery: function(text) {
        text = text.toLowerCase();
        let response = "I'm still learning intricacies of that. Try asking about SIP, Gold, or basic financial hygiene.";

        if (text.includes("sip") || text.includes("mutual fund")) {
            response = "SIPs are your best friend for rupee-cost averaging. In a " + this.marketCondition + ", consistent investing beats timing the market.";
        } else if (text.includes("gold")) {
            response = "Gold acts as a hedge against volatility. Consider Sovereign Gold Bonds (SGBs) for 2.5% extra interest over physical gold.";
        } else if (text.includes("crypto") || text.includes("bitcoin")) {
            response = "Crypto is highly volatile. If you must, limit it to <5% of your portfolio as 'play money'. Never use your emergency fund for it.";
        } else if (text.includes("debt") || text.includes("loan")) {
            response = "Use the 'Avalanche Method' (highest interest first) or 'Snowball Method' (smallest loan first). Just kill the debt before investing heavily.";
        } else if (text.includes("stock") || text.includes("market")) {
            response = "We are simulating a standard market cycle. Stick to your fundamentals and don't chase overvalued stocks.";
        } else if (text.includes("thank") || text.includes("hello") || text.includes("hi")) {
            response = "You're welcome! Let's keep your financial twin healthy.";
        }

        this.addBotMessage(response);
    }
};

