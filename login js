const canvas = document.getElementById('bg-canvas');
const ctx = canvas.getContext('2d');
let particles = [];
let width, height;

function resize() {
    width = canvas.width = window.innerWidth;
    height = canvas.height = window.innerHeight;
}

class Particle {
    constructor() {
        this.reset();
    }
    reset() {
        this.x = Math.random() * (width / 2);
        this.y = Math.random() * height;
        this.vx = (Math.random() - 0.5) * 0.5;
        this.vy = (Math.random() - 0.5) * 0.5;
        this.size = Math.random() * 2;
        this.alpha = Math.random() * 0.5;
    }
    update() {
        this.x += this.vx;
        this.y += this.vy;
        if (this.x < 0 || this.x > width/2 || this.y < 0 || this.y > height) this.reset();
    }
    draw() {
        ctx.fillStyle = `rgba(45, 212, 191, ${this.alpha})`;
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.arc(width - this.x, this.y, this.size, 0, Math.PI * 2);
        ctx.fill();
    }
}

function initParticles() {
    particles = [];
    for(let i=0; i<60; i++) particles.push(new Particle());
}

function animate() {
    ctx.clearRect(0, 0, width, height);
    particles.forEach(p => {
        p.update();
        p.draw();
    });
    requestAnimationFrame(animate);
}

window.addEventListener('load', () => {
    resize();
    initParticles();
    animate();

    const tl = gsap.timeline({ defaults: { ease: "expo.out" } });

    tl.to("#main-wrapper", { opacity: 1, duration: 1 });
    tl.to("#logo-l", { x: 0, opacity: 1, duration: 1.5 }, "-=0.5");
    tl.to("#logo-r", { x: 0, opacity: 1, duration: 1.5 }, "-=1.5");
    tl.from("#main-title", { y: 30, opacity: 0, duration: 1 }, "-=1");
    tl.from(".input-container", { x: 20, opacity: 0, stagger: 0.1, duration: 0.8 }, "-=0.8");
    tl.from("#sim-preview", { scale: 0.9, opacity: 0, duration: 1.2 }, "-=1");

    gsap.to("#progress-bar", {
        width: "95%",
        duration: 4,
        repeat: -1,
        yoyo: true,
        ease: "sine.inOut"
    });
});

window.addEventListener('resize', resize);

document.getElementById('loginForm').addEventListener('submit', (e) => {
    e.preventDefault();
    const btn = document.getElementById('submitBtn');
    btn.innerHTML = "ESTABLISHING MIRROR...";
    btn.classList.add('opacity-50');
});
