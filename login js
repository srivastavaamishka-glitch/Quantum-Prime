    const monthlyRent = parseInt(document.getElementById('input-rent').value);
    const monthlyLifestyle = parseInt(document.getElementById('input-lifestyle').value);
    const expenses = (monthlyRent + monthlyLifestyle) * 12;
    let corpus = parseInt(document.getElementById('input-assets').value);
    const frictionType = document.querySelector('input[name="mismanagement"]:checked').value;
    
    // Financial Summary Calculations
    const monthlyTotalExpense = monthlyRent + monthlyLifestyle;
    const monthlySurplus = salary - monthlyTotalExpense;
    const savingsRate = Math.round((monthlySurplus / salary) * 100);
    const runwayMonths = Math.round(corpus / monthlyTotalExpense);
    let runwayDisplay = runwayMonths + " Months";
    if (runwayMonths > 24) runwayDisplay = (runwayMonths / 12).toFixed(1) + " Years";

