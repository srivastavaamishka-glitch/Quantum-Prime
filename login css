:root {
    --accent-teal: #2dd4bf;
    --accent-blue: #3b82f6;
    --accent-red: #ef4444;
    --accent-gold: #fbbf24;
    --bg-dark: #0a0c10;
}
body {
    font-family: 'Inter', sans-serif;
    background-color: var(--bg-dark);
    overflow-x: hidden;
    color: #e2e8f0;
}
/* --- SHARED STYLES --- */
#bg-canvas {
    position: fixed;
    top: 0; left: 0;
    z-index: -1;
}

.glass-panel {
    background: rgba(13, 17, 23, 0.7);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
}

